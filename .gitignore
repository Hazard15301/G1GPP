# G1GPP repository safety rules

# ROMs / cartridges
*.gb
*.gbc
*.rom

# Saves / emulator state
*.sav
*.srm
*.state
*.ss0
*.ss1
*.ss2

# Raw emulator / research captures
*.bin
*.raw
*.dmp
*.dump
*.mp4
*.avi
*.mkv
*.mov

# Runtime logs
*.log
g1gpp_debug.log

# Build and distribution artifacts
build/
dist/
release/
*.zip
*.7z
*.rar

# Workstation-specific build configuration
/tools/build_toolchain.json

# Private development-only mod files. The public package builder also rejects
# these explicitly, but keeping them out of GitHub makes source downloads safe.
/g1gpp/DEVELOPMENT_BUILD_NOTICE.txt
/g1gpp/developer_tools/
/g1gpp/data/encounters.lua
/g1gpp/modules/debug_battle_escape.lua
/g1gpp/modules/debug_inventory_tools.lua
/g1gpp/modules/debug_menu_groups.lua
/g1gpp/modules/debug_surf_access.lua
/g1gpp/modules/glitch_pokedex_viewer.lua
/tools/tests/debug_battle_escape_spec.lua
/tools/tests/debug_inventory_tools_spec.lua
/tools/tests/debug_tools_spec.lua

# Private research/evidence directories
research/private/
captures/
evidence/
private/

# Temporary / backup files
*.tmp
*.temp
*.bak
*.old
*~

# Python cache
__pycache__/
*.py[cod]

# OS/editor junk
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/
